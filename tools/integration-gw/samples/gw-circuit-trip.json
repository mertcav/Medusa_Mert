{
  "$comment": "Sentetik — bağımlılık hatasında devre açılır (R6): 3 ardışık başarısız çağrı → OPEN; sonraki çağrı upstream'e değmeden fail-fast kısa-devre (R7).",
  "name": "gw-circuit-trip",
  "seed": 2,
  "policy": {
    "timeout_ms": 500, "max_attempts": 1, "base_backoff_ms": 50, "backoff_multiplier": 2.0,
    "max_backoff_ms": 1000, "jitter": "full", "retry_writes_require_idempotency": true,
    "breaker": {"failure_threshold": 3, "window_size": 10, "min_calls": 6, "rate_threshold": 0.9,
                "cooldown_ms": 5000, "half_open_max_probes": 1, "half_open_success_to_close": 1}
  },
  "calls": [
    {"call_id": "c0", "correlation_id": "corr-ct-0", "endpoint": "billing.read", "operation_class": "read",
     "attempts_script": [{"result": "fault", "fault_class": "UPSTREAM_5XX", "latency_ms": 30}]},
    {"call_id": "c1", "correlation_id": "corr-ct-1", "endpoint": "billing.read", "operation_class": "read",
     "attempts_script": [{"result": "fault", "fault_class": "CONN_RESET", "latency_ms": 20}]},
    {"call_id": "c2", "correlation_id": "corr-ct-2", "endpoint": "billing.read", "operation_class": "read",
     "attempts_script": [{"result": "fault", "fault_class": "UPSTREAM_5XX", "latency_ms": 30}]},
    {"call_id": "c3", "correlation_id": "corr-ct-3", "endpoint": "billing.read", "operation_class": "read",
     "attempts_script": [{"result": "ok", "latency_ms": 40}]}
  ],
  "expect": {
    "c0": {"status": "failed", "attempts": 1, "fault_class": "UPSTREAM_5XX"},
    "c2": {"status": "failed", "breaker_state_after": "OPEN"},
    "c3": {"status": "short_circuited", "attempts": 0, "short_circuited": true, "fault_class": "CIRCUIT_OPEN"}
  }
}
