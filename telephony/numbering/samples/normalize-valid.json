    { "input": "+902123456789",         "default_region": "TR", "expected": "+902123456789" },
    { "input": "00 44 1632 960123",     "default_region": "TR", "expected": "+441632960123" },
    { "input": "01632 960123",          "default_region": "GB", "expected": "+441632960123" },
    { "input": "07700 900123",          "default_region": "GB", "expected": "+447700900123" },
    { "input": "(202) 555-0143",        "default_region": "US", "expected": "+12025550143" },
    { "input": "1 202 555 0143",        "default_region": "US", "expected": "+12025550143" },
    { "input": "011 44 1632 960123",    "default_region": "US", "expected": "+441632960123" },
