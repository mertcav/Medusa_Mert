    { "input": "abc-def",               "default_region": "TR", "expected": null, "reject": true },
    { "input": "+1234567890123456",     "default_region": "US", "expected": null, "reject": true },
    { "input": "0212 345",              "default_region": "TR", "expected": null, "reject": true }
