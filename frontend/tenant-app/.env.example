# @chanteur/tenant-app (L1+L2) — örnek ortam değişkenleri (ADR-011 public).
# GERÇEK DEĞER YAZILMAZ — yalnız deploy ortamından enjekte edilir (sır/credential repoya girmez).
TENANT_APP_ORIGIN=           # public origin
TENANT_AUTH_ISSUER=          # tenant auth realm OIDC issuer (platform realm'inden AYRI — FR-IAM-008)
TENANT_API_BASE_URL=         # Tenant Application Plane API (12.2.x — ayrı servis)
TENANT_SESSION_COOKIE=       # oturum çerezi adı (vars: __chanteur_tenant_session) — SIR DEĞİL, yalnız ad (13.1.2)
