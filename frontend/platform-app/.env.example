# @chanteur/platform-app (L0) — örnek ortam değişkenleri (ADR-011 internal-only).
# GERÇEK DEĞER YAZILMAZ — yalnız deploy ortamından enjekte edilir (sır/credential repoya girmez).
PLATFORM_APP_ORIGIN=         # internal-only origin (VPN/allowlist/private endpoint arkası)
PLATFORM_AUTH_ISSUER=        # platform auth realm OIDC issuer (tenant realm'inden AYRI — FR-IAM-008)
PLATFORM_API_BASE_URL=       # L0 Platform Control Plane API (ayrı servis — SAD §14.4.2)
PLATFORM_SESSION_COOKIE=     # oturum çerezi adı (vars: __chanteur_platform_session) — SIR DEĞİL, yalnız ad (13.1.2)
